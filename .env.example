# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm db:start` (printed as API URL / anon key / service_role key).

# --- App ---
APP_URL=http://127.0.0.1:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by Drizzle (local default shown)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Auth / SSO (providers enabled by config) ---
# Comma-separated subset of: google,microsoft
SSO_PROVIDERS=
FEATURE_SAML=false
SAML_PROVIDER_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Worship Library <no-reply@example.org>"

# --- Monitoring (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Cron ---
CRON_SECRET=
