# Copy to .env.local and fill in. Never commit real values.
# Local values come from `pnpm db:start` (printed as API URL / anon key / service_role key).

# --- App ---
APP_URL=http://127.0.0.1:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by Drizzle (local default shown)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Vercel only: Supabase session pooler (port 5432). When set, each deploy runs migrations first
# (scripts/vercel-build.sh). Leave unset locally; use `pnpm db:migrate`.
MIGRATION_DATABASE_URL=

# --- Auth / SSO (providers enabled by config) ---
# Comma-separated subset of: google,microsoft
SSO_PROVIDERS=
# Local Supabase CLI only (supabase/config.toml reads these). Hosted: set the same values under Auth > Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_URL=
FEATURE_SAML=false
SAML_PROVIDER_ID=

# --- Email (SMTP; Gmail app password by default) ---
# Leave SMTP_USER/SMTP_PASSWORD empty locally: emails are logged instead of sent.
# SMTP_HOST defaults to smtp.gmail.com and SMTP_PORT to 465 (implicit TLS) when unset.
SMTP_HOST=
SMTP_PORT=
# The sending Gmail address and its 16-character Google app password (secret).
SMTP_USER=
SMTP_PASSWORD=
# Gmail requires the address part to be SMTP_USER; only the display name is free.
# Defaults to "Worship Library <SMTP_USER>" when unset.
EMAIL_FROM=

# --- Monitoring (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build time only (Vercel): uploads source maps and creates releases when the token is set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Cron ---
CRON_SECRET=
